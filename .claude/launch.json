{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "control-plane-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@lab-connect/control-plane-web", "dev"],
      "port": 5173
    },
    {
      "name": "control-plane-web-local-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "LC_API_TARGET=http://localhost:8080 pnpm --filter @lab-connect/control-plane-web dev"
      ],
      "port": 5173
    },
    {
      "name": "gateway-desktop",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@lab-connect/gateway-desktop", "dev"],
      "port": 1420
    }
  ]
}
